programa {


  funcao inicio() {
    
    inteiro numero[5]

    escreva("Digite a primeira posição: ")
    leia(numero[0])

    escreva("Digite a segunda posição: ")
    leia(numero[1])

    escreva("Digite a terceira posição: ")
    leia(numero[2])

    numero[3] = 6
    numero[4] = 7

    escreva(numero)
  }
}
