programa
{
    funcao inicio()
    {
        inteiro senha
        
        escreva("Informe a senha: ")
        leia(senha)

        se (senha != 1234)
        {
            escreva("Acesso Negado")
        }
        senao
        {
            escreva("Acesso Liberado")
        }


        // Faltou escreva, para o usuário informar os valores.
        // Ordem das frases ao contrário.
    }
}