programa
{
    funcao inicio()
    {
        inteiro numero

        escreva("Informe um número: ")
        leia(numero)

        se (numero > 0)
        {
            escreva("Número positivo")
        } senao se(numero < 0) {
            escreva("Número negativo") 
        } senao {
            escreva("Número igual a zero")
        }




        // Falta o escreva, para o usuário informar os valores.
        // Sinal de maior virado para o (0), semdo que queria positivo.
        // Faltando um (se), para número igual a (0) e menor que (0).
        // Faltou acentuação na letra (u) da linha 7. (Desculpa, Tenho toque)
    }
}