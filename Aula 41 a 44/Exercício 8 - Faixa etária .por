programa
{
    funcao inicio()
    {
        inteiro idade
        escreva("informe a idade: ")
        leia(idade)

        se (idade >= 12 e idade <= 17)
        {
            escreva("Adolescente")
        }
        senao
        {
            escreva("Não é adolescente")
        }

        // Faltou escreva, para o usuário informar os valores.
        // Porta (ou) no lugar da porta (e).
    }
}