programa
{
    funcao inicio()
    {
        real largura, altura
        real area

        escreva("Informe a largura: ")
        leia(largura)

        escreva("Informe a altura: ")
        leia(altura)

        area = largura * altura

        escreva("Área: ", area)

        // Falta a função escreva para o usuário informar os valores.
        // Tinha variável (inteiro) no lugar da (real).
    }
}